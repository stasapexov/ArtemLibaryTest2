<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf"
        xmlns:ui="moder"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Border Background="WhiteSmoke" CornerRadius="12">
        <Grid>
            <Border Margin="10" Padding="5" VerticalAlignment="Top" Background="#F1FFFFFF" CornerRadius="12" x:Name="Filter_Border">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TbMin" Margin="10,10,0,10" Width="80" ui:ControlHelper.CornerRadius="8" ui:ControlHelper.Description="Мин. цена"/>
                    <TextBox x:Name="TbMax" Margin="10,10,0,10" Width="80" ui:ControlHelper.CornerRadius="8" ui:ControlHelper.Description="Макс. цена"/>
                    <TextBox x:Name="TbName" Margin="10,10,0,10" Width="130" ui:ControlHelper.CornerRadius="8" ui:ControlHelper.Description="Название"/>
                    <ComboBox x:Name="ComboData" Margin="10,10,0,10" Width="120" ui:ControlHelper.CornerRadius="8" DisplayMemberPath="name" SelectedIndex="0" SelectedValuePath="id"/>
                    <Button Click="Filter_Click" Content="Найти" Margin="10,-2,0,10" Width="100" Height="40" ui:ControlHelper.CornerRadius="12" Background="#FF0088FF" Foreground="White"/>
                    <TextBlock x:Name="LableMoney"/>
                </StackPanel>
            </Border>
            <Border Margin="10,96,10,0" Background="White" CornerRadius="12" Padding="5" x:Name="Shop_Border">
                <ui:ScrollViewerEx>
                    <ItemsControl x:Name="ItemsData">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" BorderBrush="Black" BorderThickness="1" CornerRadius="12" Margin="5" Padding="5">
                                    <StackPanel>
                                        <Image Source="{Binding Img}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Height="140"/>
                                        <TextBlock Text="{Binding name,StringFormat=Название:{0}}" FontSize="13" FontWeight="Black" Margin="5,0,5,5"/>
                                        <TextBlock Text="{Binding quantity,StringFormat=На складе:{0}}" Margin="5,0,5,5"/>
                                        <TextBlock Text="{Binding categories_name,StringFormat=Категория:{0}}" Margin="5,0,5,5"/>
                                        <TextBlock Text="{Binding price,StringFormat=Цена за еденицу:{0}}" Margin="5,0,5,5"/>
                                        <TextBlock x:Name="TotalPriceLable" Margin="5,0,5,5"/>
                                        <Button Click="Characteristick_Click" Content="Характеристики" Margin="5,-2,0,10" Width="80" Height="30" ui:ControlHelper.CornerRadius="8" Background="#FF0088FF" Foreground="White"/>
                                        <DockPanel>
                                            <TextBox TextChanged="Count_Change_Click" x:Name="TbCount" Margin="5,0,5,5" Width="80" ui:ControlHelper.CornerRadius="8" ui:ControlHelper.Description="Кол-во"/>
                                            <Button Click="Order_Click" Content="Заказать" Margin="5,-2,0,10" Width="80" Height="30" ui:ControlHelper.CornerRadius="8" Background="#FF0088FF" Foreground="White" Visibility="{Binding IsUserVisible}"/>
                                            <Button Click="Edit_Click" Content="Изменить" Margin="5,-2,0,10" Width="80" Height="30" ui:ControlHelper.CornerRadius="8" Background="#FF0088FF" Foreground="White" Visibility="{Binding IsAdminVisible}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:ScrollViewerEx>
            </Border>
        </Grid>
    </Border>
</Window>

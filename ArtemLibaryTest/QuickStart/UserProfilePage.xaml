<Page x:Class="ArtemLibaryTest.QuickStart.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="UserProfilePage">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,16,0">
            <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="NameText" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="LoginText" FontSize="16" Margin="0,8,0,0"/>
            <TextBlock x:Name="PasswordText" FontSize="16" Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="MoneyText" FontSize="16" VerticalAlignment="Center"/>
                <Button Content="Пополнить" Width="130" Height="30" Margin="12,0,0,0" Click="TopUp_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

<Page x:Class="ArtemLibaryTest.QuickStart.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="UserProfilePage">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,24,0"
                BorderBrush="#E5E5E5"
                BorderThickness="1">

            <ui:SimpleStackPanel Spacing="16" VerticalAlignment="Stretch">
                <Border CornerRadius="8"
                        ClipToBounds="True"
                        Height="220"
                        Background="#F3F3F3">
                    <Image x:Name="AvatarImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <Button Content="Сменить аватар"
                        HorizontalAlignment="Stretch"
                        Click="ChangeAvatar_Click"/>

                <TextBlock x:Name="NameText"
                           Text="Имя Пользователя"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <Border Background="#F9F9F9" CornerRadius="8" Padding="12">
                    <ui:SimpleStackPanel Spacing="8">
                        <TextBlock Text="Текущий баланс:" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="MoneyText" Text="0.00 ₽" FontSize="20" FontWeight="SemiBold" Foreground="#107C41"/>
                        <Button Content="Пополнить баланс"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0"
                                Click="TopUp_Click"/>
                    </ui:SimpleStackPanel>
                </Border>
            </ui:SimpleStackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="24"
                BorderBrush="#E5E5E5"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Персональная информация"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ui:SimpleStackPanel Spacing="12" Margin="0,0,8,0">

                        <TextBox x:Name="LoginInput"
                                 ui:ControlHelper.Header="Логин"
                                 ui:ControlHelper.PlaceholderText="Введите логин"
                                 FontSize="14"/>

                        <PasswordBox x:Name="PasswordInput"
                                     ui:ControlHelper.Header="Пароль"
                                     FontSize="14"/>

                        <TextBox x:Name="EmailInput"
                                 ui:ControlHelper.Header="Электронная почта"
                                 ui:ControlHelper.PlaceholderText="example@domain.com"
                                 FontSize="14"/>

                        <TextBox x:Name="PhoneInput"
                                 ui:ControlHelper.Header="Номер телефона"
                                 ui:ControlHelper.PlaceholderText="+7 (___) ___-__-__"
                                 FontSize="14"/>

                    </ui:SimpleStackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Content="Сохранить изменения"
                        Height="40"
                        HorizontalAlignment="Right"
                        Width="200"
                        Margin="0,16,0,0"
                        Click="SaveProfile_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>

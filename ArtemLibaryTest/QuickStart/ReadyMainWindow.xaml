<Window x:Class="ArtemLibaryTest.QuickStart.ReadyMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Height="520" Width="980" WindowStartupLocation="CenterScreen">
    <Grid>
        <ui:NavigationView x:Name="NavView"
                           PaneDisplayMode="Left"
                           IsSettingsVisible="False"
                           SelectionChanged="NavView_SelectionChanged">
            <ui:NavigationView.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="    "/>
                    <TextBlock x:Name="UserInfoText" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:NavigationView.Header>

            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </ui:NavigationView>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
            <Button Content="Профиль" Width="100" Height="32" Margin="0,0,8,0" Click="OpenProfile_Click"/>
            <Button Content="Техподдержка" Width="120" Height="32" Margin="0,0,8,0" Click="OpenSupport_Click"/>
            <Button Content="Выйти" Width="100" Height="32" Click="Logout_Click"/>
        </StackPanel>
    </Grid>
</Window>

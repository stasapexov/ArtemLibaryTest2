<Window x:Class="ArtemLibaryTest.QuickStart.TechSupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Техподдержка" Height="560" Width="860" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ModeText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Frame Grid.Row="1"
               x:Name="ClientChatFrame"
               NavigationUIVisibility="Hidden"
               Visibility="Collapsed"/>

        <Grid Grid.Row="1" x:Name="StaffPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Клиенты" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClientsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Frame Grid.Column="1"
                   x:Name="StaffChatFrame"
                   NavigationUIVisibility="Hidden"/>
        </Grid>

        <Button Grid.Row="2" Content="Закрыть" Width="120" Height="32" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
    </Grid>
</Window>

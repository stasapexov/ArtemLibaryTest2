<Page x:Class="ArtemLibaryTest.QuickStart.ProductsOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказ товаров">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="NameFilterTextBox" Width="180" Margin="0,0,8,0" ToolTip="Название"/>
            <TextBox x:Name="MinPriceTextBox" Width="100" Margin="0,0,8,0" ToolTip="Мин. цена"/>
            <TextBox x:Name="MaxPriceTextBox" Width="100" Margin="0,0,8,0" ToolTip="Макс. цена"/>
            <ComboBox x:Name="CategoryComboBox" Width="180" DisplayMemberPath="name" SelectedValuePath="id" Margin="0,0,8,0"/>
            <Button Content="Фильтровать" Click="Filter_Click" Margin="0,0,8,0"/>
            <Button Content="Сброс" Click="Reset_Click" Margin="0,0,8,0"/>
            <TextBox x:Name="QuantityTextBox" Width="80" Margin="0,0,8,0" Text="1" ToolTip="Количество"/>
            <Button Content="Заказать" Click="Order_Click"/>
        </StackPanel>

        <DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Page>

<Window x:Class="ArtemLibaryTest.QuickStart.TopUpMoneyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пополнение" Height="320" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Номер карты"/>
            <TextBox x:Name="CardNumberBox"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Сумма"/>
            <TextBox x:Name="AmountBox"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Пароль аккаунта"/>
            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <Button Grid.Row="3" Height="32" Content="Пополнить" Click="TopUp_Click"/>
    </Grid>
</Window>
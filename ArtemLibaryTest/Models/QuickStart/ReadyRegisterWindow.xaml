<Window x:Class="ArtemLibaryTest.QuickStart.ReadyRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="460" Width="360">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Имя"/>
            <TextBox x:Name="NameBox" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Телефон"/>
            <TextBox x:Name="PhoneBox"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Почта"/>
            <TextBox x:Name="EmailBox"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginBox"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <Button Grid.Row="5" Content="Создать аккаунт" Height="32" Click="Register_Click" Margin="0,13,0,-13"/>
        <Button Grid.Row="5" Content="Войти в аккаунт" Height="32" Click="GoToRegister_Click" Margin="0,50,0,-50"/>
    </Grid>
</Window>
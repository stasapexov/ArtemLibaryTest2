 <Window x:Class="ArtemLibaryTest.QuickStart.ReadyLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="300" Width="360" WindowStartupLocation="CenterScreen">
    <Grid Margin="16,16,16,9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Логин" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginBox" Height="40"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Пароль" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="38"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Войти" Height="30" Click="Login_Click"/>
            <Button Content="Войти как гость" Height="30" Margin="0,8,0,0" Click="GuestLogin_Click"/>
        </StackPanel>
        <Button Grid.Row="3" Content="Регистрация" Height="30" Margin="0,8,0,0" Click="GoToRegister_Click"/>
    </Grid>
</Window>
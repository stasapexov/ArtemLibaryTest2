<Window x:Class="ArtemLibaryTest.Models.QuickStart.ReadyLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="260" Width="360" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginBox"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Войти" Height="32" Click="Login_Click" Margin="0,0,0,8"/>
        <Button Grid.Row="3" Content="Регистрация" Height="32" Click="GoToRegister_Click"/>
    </Grid>
</Window>

<Window x:Class="SampleWpf.CustomRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свое окно регистрации" Height="520" Width="420" WindowStartupLocation="CenterScreen">
    <Border Padding="24" Background="#FFF8F0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Регистрация через мое окно"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="Имя" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="34"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Телефон" Margin="0,0,0,4"/>
                <TextBox x:Name="PhoneBox" Height="34"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="Email" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox" Height="34"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock Text="Логин" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginBox" Height="34"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,16">
                <TextBlock Text="Пароль" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="34"/>
            </StackPanel>

            <StackPanel Grid.Row="6">
                <Button Content="Зарегистрироваться"
                        Height="36"
                        Click="Register_Click"/>
                <Button Content="Уже есть аккаунт — войти"
                        Height="34"
                        Margin="0,10,0,0"
                        Click="OpenLogin_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

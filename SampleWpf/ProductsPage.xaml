<Page x:Class="SampleWpf.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Products">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Товары" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="RoleHintText" Margin="0,4,0,10" Foreground="Gray" />
            <Grid x:Name="EditorPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,6" />
                <TextBlock Text="Категория id:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="CategoryIdBox" Grid.Row="0" Grid.Column="3" Margin="0,0,10,6" />
                <TextBlock Text="Остаток:" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="QuantityBox" Grid.Row="0" Grid.Column="5" Margin="0,0,10,6" />
                <TextBlock Text="Цена:" Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="PriceBox" Grid.Row="0" Grid.Column="7" Margin="0,0,10,6" />
                <TextBlock Text="Фото:" Grid.Row="0" Grid.Column="8" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="PhotoBox" Grid.Row="0" Grid.Column="9" Margin="0,0,0,6" />

                <TextBlock Text="Материал:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="MaterialBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,6" />
                <TextBlock Text="Цвет:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="ColorBox" Grid.Row="1" Grid.Column="3" Margin="0,0,10,6" />
                <TextBlock Text="Размеры:" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="DimensionsBox" Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" Margin="0,0,10,6" />
                <TextBlock Text="Описание:" Grid.Row="1" Grid.Column="8" VerticalAlignment="Center" Margin="0,0,6,6" />
                <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="9" Margin="0,0,0,6" />

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="10" Orientation="Horizontal">
                    <Button Content="Сохранить выбранный товар" Click="SaveButton_Click" Padding="12,6" />
                    <Button Content="Удалить выбранный товар" Click="DeleteButton_Click" Margin="8,0,0,0" Padding="12,6" />
                    <Button Content="Обновить" Click="RefreshButton_Click" Margin="8,0,0,0" Padding="12,6" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ProductsGrid_SelectionChanged" />
    </DockPanel>
</Page>

<Page x:Class="SampleWpf.ShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ShopPage">
    <Border Background="WhiteSmoke" CornerRadius="12" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Margin="0,0,0,8" Padding="5" VerticalAlignment="Top" Background="#F1FFFFFF" CornerRadius="12" x:Name="Filter_Border">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TbMin" Margin="10,10,0,10" Width="80"/>
                    <TextBox x:Name="TbMax" Margin="10,10,0,10" Width="80"/>
                    <TextBox x:Name="TbName" Margin="10,10,0,10" Width="130"/>
                    <ComboBox x:Name="ComboData" Margin="10,10,0,10" Width="140" DisplayMemberPath="name" SelectedIndex="0" SelectedValuePath="id"/>
                    <Button Click="Filter_Click" Content="Найти" Margin="10,10,0,10" Width="100" Height="32" Background="#FF0088FF" Foreground="White"/>
                    <TextBlock x:Name="LableMoney" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="5" x:Name="Shop_Border">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsData">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190" BorderBrush="Black" BorderThickness="1" CornerRadius="12" Margin="5" Padding="5">
                                    <StackPanel>
                                        <Image Source="{Binding Img}" Stretch="Uniform" Height="140"/>
                                        <TextBlock Text="{Binding name,StringFormat=Название:{0}}" FontWeight="Bold" Margin="5,0,5,5"/>
                                        <TextBlock Text="{Binding quantity,StringFormat=На складе:{0}}" Margin="5,0,5,5"/>
                                        <TextBlock Text="{Binding category_name,StringFormat=Категория:{0}}" Margin="5,0,5,5"/>
                                        <TextBlock Text="{Binding price,StringFormat=Цена за еденицу:{0}}" Margin="5,0,5,5"/>
                                        <TextBlock x:Name="TotalPriceLable" Margin="5,0,5,5"/>
                                        <Button Click="Characteristick_Click" Content="Характеристики" Margin="5,0,0,8" Width="110" Height="28" Background="#FF0088FF" Foreground="White"/>
                                        <DockPanel>
                                            <TextBox TextChanged="Count_Change_Click" x:Name="TbCount" Margin="5,0,5,5" Width="70" Text="1"/>
                                            <Button Click="Order_Click" Content="Заказать" Margin="5,0,0,8" Width="80" Height="28" Background="#FF0088FF" Foreground="White" Visibility="{Binding IsUserVisible}"/>
                                            <Button Click="Edit_Click" Content="Изменить" Margin="5,0,0,8" Width="80" Height="28" Background="#FF0088FF" Foreground="White" Visibility="{Binding IsAdminVisible}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Page>

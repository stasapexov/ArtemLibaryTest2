<Page x:Class="SampleWpf.ShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Shop">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Магазин мебели" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="ModeText" Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="QuantityBox" Width="80" Text="1" Margin="0,0,8,0" />
                <Button x:Name="OrderButton" Content="Заказать выбранный товар" Click="OrderButton_Click" Padding="12,6" />
                <Button Content="Обновить" Click="RefreshButton_Click" Margin="8,0,0,0" Padding="12,6" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" />
    </DockPanel>
</Page>

<Page x:Class="SampleWpf.ProductOrderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.modernwpf.com/2019" Title="ProductOrderPage">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="TbName" Width="180" Margin="0,0,8,0" ui:ControlHelper.PlaceholderText="Название"/>
            <TextBox x:Name="TbMin" Width="100" Margin="0,0,8,0" ui:ControlHelper.PlaceholderText="Мин. цена"/>
            <TextBox x:Name="TbMax" Width="100" Margin="0,0,8,0" ui:ControlHelper.PlaceholderText="Макс. цена"/>
            <ComboBox x:Name="CbCategory" Width="180" DisplayMemberPath="name" SelectedValuePath="id" Margin="0,0,8,0"/>
            <Button Content="Фильтр" Click="Filter_Click"/>
        </StackPanel>
        <ui:ScrollViewerEx Grid.Row="1">
            <ItemsControl x:Name="ProductsItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Background="White" CornerRadius="12" Margin="10" Padding="8">
                            <StackPanel>
                                <Image Source="{Binding Img}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Height="140"/>
                                <TextBlock Text="{Binding material_name,StringFormat=Название: {0}}" Margin="5" FontSize="13" FontWeight="Black"/>
                                <TextBlock Text="{Binding category,StringFormat=Категория: {0}}" Margin="5"/>
                                <TextBlock Text="{Binding quantity,StringFormat=На складе: {0}}" Margin="5"/>
                                <TextBlock Text="{Binding price,StringFormat=Цена за шт.: {0}}" Margin="5"/>
                                <DockPanel>
                                    <TextBox Text="1" TextChanged="Text_Click" x:Name="TbCount" Margin="5" Width="70" ui:ControlHelper.CornerRadius="8" ui:ControlHelper.Description="Кол-во"/>
                                    <Button Click="Order_Click" Content="Заказать" Height="30" Width="90" Margin="10" VerticalAlignment="Top" Background="#FF0088FF" Foreground="White" ui:ControlHelper.CornerRadius="8"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:ScrollViewerEx>
    </Grid>
</Page>

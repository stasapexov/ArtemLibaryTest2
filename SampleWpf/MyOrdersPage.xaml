<Page x:Class="SampleWpf.MyOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MyOrders">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Мои заказы" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Обновить" Click="RefreshButton_Click" Margin="16,0,0,0" Padding="12,6" />
        </StackPanel>
        <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="True" IsReadOnly="True" />
    </DockPanel>
</Page>

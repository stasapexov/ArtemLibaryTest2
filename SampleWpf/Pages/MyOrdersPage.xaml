<Page x:Class="SampleWpf.Pages.MyOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заказы">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="ProductNameTextBox" Width="150" Margin="0,0,6,6" ToolTip="Название товара" />
            <TextBox x:Name="MinPriceTextBox" Width="90" Margin="0,0,6,6" ToolTip="Цена от" />
            <TextBox x:Name="MaxPriceTextBox" Width="90" Margin="0,0,6,6" ToolTip="Цена до" />
            <TextBox x:Name="DateTextBox" Width="110" Margin="0,0,6,6" ToolTip="Дата: yyyy-mm-dd" />
            <Button Content="Фильтр" Click="Filter_Click" Width="90" Margin="0,0,6,6" />
            <Button Content="Сброс" Click="ResetFilter_Click" Width="90" Margin="0,0,6,6" />
            <Button Content="Обновить" Click="Refresh_Click" Width="100" Margin="0,0,6,6" />
            <TextBlock x:Name="InfoTextBlock" Margin="12,4,0,0" FontWeight="Bold" />
        </WrapPanel>
        <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding order_id}" Width="60" />
                <DataGridTextColumn Header="Дата" Binding="{Binding order_date}" Width="100" />
                <DataGridTextColumn Header="Товар" Binding="{Binding product_name}" Width="*" />
                <DataGridTextColumn Header="Кол-во" Binding="{Binding quantity}" Width="70" />
                <DataGridTextColumn Header="Сумма" Binding="{Binding total_price}" Width="90" />
                <DataGridTextColumn Header="Статус" Binding="{Binding readiness}" Width="120" />
                <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding pickup_address}" Width="220" />
                <DataGridTextColumn Header="Код получения" Binding="{Binding pickup_code}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>

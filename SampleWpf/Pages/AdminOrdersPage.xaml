<Page x:Class="SampleWpf.Pages.AdminOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Все заказы">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Обновить" Click="Refresh_Click" Width="100" Margin="0,0,6,0" />
                <ComboBox x:Name="ReadinessComboBox" Width="150" Margin="0,0,6,0">
                    <ComboBoxItem Content="New" IsSelected="True" />
                    <ComboBoxItem Content="InProgress" />
                    <ComboBoxItem Content="Ready" />
                    <ComboBoxItem Content="Done" />
                    <ComboBoxItem Content="Canceled" />
                </ComboBox>
                <Button Content="Сменить статус" Click="SaveStatus_Click" Width="130" Margin="0,0,6,0" />
                <Button Content="Удалить заказ" Click="DeleteOrder_Click" Width="120" />
                <TextBlock x:Name="OrdersInfoTextBlock" Margin="12,6,0,0" FontWeight="Bold" />
            </StackPanel>
            <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding order_id}" Width="55" />
                    <DataGridTextColumn Header="Дата" Binding="{Binding order_date}" Width="90" />
                    <DataGridTextColumn Header="Клиент" Binding="{Binding user_login}" Width="90" />
                    <DataGridTextColumn Header="Товар" Binding="{Binding product_name}" Width="*" />
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding quantity}" Width="65" />
                    <DataGridTextColumn Header="Сумма" Binding="{Binding total_price}" Width="80" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding readiness}" Width="100" />
                    <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding pickup_address}" Width="220" />
                    <DataGridTextColumn Header="Код" Binding="{Binding pickup_code}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Separator Grid.Row="1" Margin="0,10" />

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Пункты выдачи" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                <WrapPanel>
                    <TextBox x:Name="PickupNameTextBox" Width="130" Margin="0,0,6,6" ToolTip="Название" />
                    <TextBox x:Name="PickupAddressTextBox" Width="280" Margin="0,0,6,6" ToolTip="Адрес" />
                    <TextBox x:Name="PickupPhoneTextBox" Width="120" Margin="0,0,6,6" ToolTip="Телефон" />
                    <TextBox x:Name="PickupHoursTextBox" Width="130" Margin="0,0,6,6" ToolTip="Часы работы" />
                    <Button Content="Добавить" Click="AddPickupPoint_Click" Width="90" Margin="0,0,6,6" />
                    <Button Content="Удалить" Click="DeletePickupPoint_Click" Width="90" Margin="0,0,6,6" />
                </WrapPanel>
            </StackPanel>
            <DataGrid x:Name="PickupPointsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding id}" Width="50" />
                    <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="150" />
                    <DataGridTextColumn Header="Адрес" Binding="{Binding address}" Width="260" />
                    <DataGridTextColumn Header="Телефон" Binding="{Binding phone}" Width="120" />
                    <DataGridTextColumn Header="Часы" Binding="{Binding working_hours}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Page>

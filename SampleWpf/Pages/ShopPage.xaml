<Page x:Class="SampleWpf.Pages.ShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Магазин">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="#FFF1F1F1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <TextBox x:Name="TbMin" Width="80" Margin="4" ToolTip="Минимальная цена" />
                    <TextBox x:Name="TbMax" Width="80" Margin="4" ToolTip="Максимальная цена" />
                    <TextBox x:Name="TbName" Width="150" Margin="4" ToolTip="Название товара" />
                    <ComboBox x:Name="CategoryComboBox" Width="160" Margin="4" />
                    <Button Content="Фильтр" Click="Filter_Click" Width="90" Margin="4" />
                    <TextBlock x:Name="MoneyTextBlock" Margin="12,8,4,4" FontWeight="Bold" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="Пункт выдачи:" VerticalAlignment="Center" Margin="4" />
                    <ComboBox x:Name="PickupPointComboBox" Width="360" Margin="4" />
                    <Button Content="Обновить" Click="Refresh_Click" Width="90" Margin="4" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsData">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Background="White" BorderThickness="1" BorderBrush="#FFCCCCCC" CornerRadius="8" Margin="6" Padding="8">
                            <StackPanel>
                                <Image Source="{Binding Img}" Stretch="Uniform" Height="120" />
                                <TextBlock Text="{Binding name, StringFormat=Название: {0}}" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding category_name, StringFormat=Категория: {0}}" />
                                <TextBlock Text="{Binding quantity, StringFormat=На складе: {0}}" />
                                <TextBlock Text="{Binding price, StringFormat=Цена: {0}}" />
                                <TextBlock x:Name="TotalPriceTextBlock" Text="Итоговая цена: 0" Margin="0,4,0,0" FontWeight="SemiBold" />
                                <Button Content="Характеристики" Click="Characteristic_Click" Margin="0,6,0,0" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBox x:Name="CountTextBox" Text="1" Width="70" TextChanged="CountTextBox_TextChanged" />
                                    <Button Content="Заказать" Click="Order_Click" Margin="6,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>

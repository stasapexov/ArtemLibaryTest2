<Window x:Class="SampleWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sample Shop" Height="700" Width="1100">
    <DockPanel Margin="10">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Роль:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="RoleBox" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="guest"/>
                <ComboBoxItem Content="user"/>
                <ComboBoxItem Content="manager"/>
                <ComboBoxItem Content="admin"/>
            </ComboBox>
            <Button Content="Открыть страницу заказов" Margin="10,0,0,0" Click="OpenShop_Click"/>
        </StackPanel>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>

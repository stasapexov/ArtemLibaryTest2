<Window x:Class="SampleWpf.CustomLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свое окно входа" Height="340" Width="420" WindowStartupLocation="CenterScreen">
    <Border Padding="24" Background="#F4F7FB">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Вход через мое окно"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Логин" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginBox" Height="36"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <TextBlock Text="Пароль" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="36"/>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <Button Content="Войти и открыть главное меню библиотеки"
                        Height="36"
                        Click="Login_Click"/>
                <Button Content="Создать аккаунт"
                        Height="34"
                        Margin="0,10,0,0"
                        Click="OpenRegister_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
